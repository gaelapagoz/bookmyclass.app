// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MASTER_ADMIN
  ADMIN
  TEACHER
  CLIENT
}

enum UserCreatedVia {
  PUBLIC_SIGNUP
  ADMIN
  BOOKING_FLOW
  SUBSCRIPTION_FLOW
  OAUTH
  IMPORT
}

enum UserActivationStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ProductType {
  DROP_IN_CLASS
  CLASS_PACK
  PRIVATE_PACK
  UNLIMITED_MEMBERSHIP
  MERCHANDISE
  GIFT_CARD
}

enum PriceType {
  ONE_TIME
  RECURRING
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum StripeSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum EntitlementType {
  SINGLE_USE
  CREDIT_PACK
  UNLIMITED_ACCESS
  GIFT_VALUE
}

enum EntitlementScope {
  COLLECTIVE_CLASSES
  PRIVATE_CLASSES
  WORKSHOPS
  ALL_CLASSES
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudioSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum BookingIntent {
  SINGLE_BOOKING
  USE_PLAN
}

enum BookingPaymentSelection {
  SINGLE_SESSION
  EXISTING_PLAN
  NEW_PLAN_PURCHASE
}

enum ServicePricingMode {
  SINGLE_ONLY
  PLAN_ONLY
  SINGLE_OR_PLAN
}

enum WaitlistStatus {
  ACTIVE
  PROMOTED
  CANCELLED
}

enum AttendanceStatus {
  CHECKED_IN
  ATTENDED
  NO_SHOW
}

enum AttendanceSource {
  DASHBOARD
  KIOSK
}

enum OrderStatus {
  DRAFT
  PLACED
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  MANUAL
  GIFT_CARD
}

enum PaymentProvider {
  STRIPE
  MOLLIE
  MANUAL
  OTHER
  INTERNAL
}

enum GiftCardWalletStatus {
  ACTIVE
  SUSPENDED
}

enum GiftCardLedgerEntryType {
  ACTIVATION
  RESERVE
  CAPTURE
  RELEASE
}

enum GiftCardRedemptionStatus {
  RESERVED
  CAPTURED
  RELEASED
}

enum GiftCardReconciliationStatus {
  OPEN
  RETRYING
  RESOLVED
  MANUAL_REVIEW
}

enum GiftCardCodeStatus {
  ISSUED
  REDEEMED
  VOIDED
  EXPIRED
}

enum GiftCardCodeSource {
  PURCHASED
  ADMIN_GENERATED
}

enum GiftCardCodeEmailStatus {
  PENDING
  SENT
  FAILED
}

enum CheckoutSource {
  BOOKING_FLOW
  SUBSCRIPTION_CATALOG
  CART_CHECKOUT_V1
}

enum StripeCheckoutMode {
  PAYMENT
  SUBSCRIPTION
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum ClientEntitlementStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

enum CreditLedgerEntryType {
  GRANT
  CONSUME
  RESTORE
  EXPIRE
  ADJUSTMENT
}

enum LoyaltyLedgerEntryType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

enum LoyaltyCouponStatus {
  GENERATED
  SENT
  USED
  EXPIRED
  VOIDED
}

enum ContactMessageStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ClientMessageType {
  CONTACT
  BOOKING_NOTE
}

enum ClientMessageStatus {
  NEW
  READ
  ARCHIVED
}

enum ClientMessageContactStatus {
  INBOX
  SPAM
}

enum MarketingCampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum MarketingAudienceType {
  ALL_USERS
  ACTIVE_USERS
  PAYING_SUBSCRIBERS
  MANUAL
}

enum MarketingSubscriptionStatus {
  NEVER_SUBSCRIBED
  SUBSCRIBED
  UNSUBSCRIBED
}

enum MarketingRecipientStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum AdminLoginAbuseKeyType {
  IP
  EMAIL
  IP_EMAIL
}

model User {
  id                                  String                       @id @default(cuid())
  name                                String
  firstName                           String?
  lastName                            String?
  email                               String                       @unique
  passwordHash                        String?
  emailVerified                       DateTime?
  emailVerifiedAt                     DateTime?
  image                               String?
  role                                Role                         @default(CLIENT)
  isActive                            Boolean                      @default(true)
  isInactive                          Boolean                      @default(false)
  createdVia                          UserCreatedVia               @default(IMPORT)
  createdByUserId                     String?
  createdIp                           String?
  activationStatus                    UserActivationStatus         @default(ACTIVE)
  marketingSubscriptionStatus         MarketingSubscriptionStatus  @default(NEVER_SUBSCRIBED)
  lastEmailChangeAt                   DateTime?
  pendingEmail                        String?
  pendingEmailTokenHash               String?                      @unique
  pendingEmailTokenExpiresAt          DateTime?
  lastLoginAt                         DateTime?
  createdByUser                       User?                        @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                        User[]                       @relation("UserCreatedBy")
  pendingRegistrations                PendingUserRegistration[]
  clientProfile                       ClientProfile?
  teacherProfile                      TeacherProfile?
  defaultTeachingTemplates            ClassTemplate[]              @relation("TemplateDefaultTeacher")
  teachingStudioSessions              StudioSession[]              @relation("StudioSessionTeacher")
  cancelledStudioSessions             StudioSession[]              @relation("StudioSessionCancelledBy")
  clientBookings                      Booking[]                    @relation("BookingClient")
  cancelledBookings                   Booking[]                    @relation("BookingCancelledBy")
  waitlistEntries                     WaitlistEntry[]              @relation("WaitlistClient")
  markedAttendanceRecords             AttendanceRecord[]           @relation("AttendanceMarkedBy")
  orders                              Order[]                      @relation("OrderClient")
  subscriptionContracts               SubscriptionContract[]       @relation("SubscriptionClient")
  clientEntitlements                  ClientEntitlement[]          @relation("ClientEntitlementClient")
  creditLedgerEntries                 CreditLedgerEntry[]          @relation("UserCreditLedger")
  createdCreditLedgerEntries          CreditLedgerEntry[]          @relation("CreditLedgerEntryCreatedBy")
  clientLoyaltyLedgerEntries          LoyaltyLedgerEntry[]         @relation("LoyaltyLedgerEntryClient")
  createdLoyaltyEntries               LoyaltyLedgerEntry[]         @relation("LoyaltyLedgerEntryCreatedBy")
  loyaltyCoupons                      LoyaltyCoupon[]              @relation("LoyaltyCouponClient")
  giftCardWallets                     GiftCardWallet[]             @relation("GiftCardWalletClient")
  giftCardLedgerEntries               GiftCardLedgerEntry[]        @relation("GiftCardLedgerEntryClient")
  giftCardRedemptions                 GiftCardRedemption[]         @relation("GiftCardRedemptionClient")
  giftCardReconciliationCases         GiftCardReconciliationCase[] @relation("GiftCardReconciliationClient")
  resolvedGiftCardReconciliationCases GiftCardReconciliationCase[] @relation("GiftCardReconciliationResolvedBy")
  purchasedGiftCardCodes              GiftCardCode[]               @relation("PurchasedGiftCards")
  redeemedGiftCardCodes               GiftCardCode[]               @relation("RedeemedGiftCards")
  generatedGiftCardCodes              GiftCardCode[]               @relation("GeneratedGiftCards")
  voidedGiftCardCodes                 GiftCardCode[]               @relation("VoidedGiftCards")
  createdLoyaltyCoupons               LoyaltyCoupon[]              @relation("LoyaltyCouponCreatedBy")
  voidedLoyaltyCoupons                LoyaltyCoupon[]              @relation("LoyaltyCouponVoidedBy")
  createdLoyaltyRewardRules           LoyaltyRewardRule[]          @relation("LoyaltyRewardRuleCreatedBy")
  updatedLoyaltyRewardRules           LoyaltyRewardRule[]          @relation("LoyaltyRewardRuleUpdatedBy")
  auditLogsAsActor                    AuditLog[]                   @relation("AuditLogActor")
  adminNotesAuthored                  AdminNote[]                  @relation("AdminNoteAuthor")
  adminNotesAboutClient               AdminNote[]                  @relation("AdminNoteClient")
  contactMessages                     ContactMessage[]             @relation("ContactMessageClient")
  resolvedContactMessages             ContactMessage[]             @relation("ContactMessageResolvedBy")
  clientMessagesUnified               ClientMessage[]              @relation("ClientMessageUser")
  createdMarketingCampaigns           MarketingCampaign[]          @relation("MarketingCampaignCreatedBy")
  marketingRecipients                 MarketingCampaignRecipient[] @relation("MarketingRecipientUser")
  marketingUnsubscribes               MarketingUnsubscribe[]       @relation("MarketingUnsubscribeUser")
  marketingSegments                   MarketingUserSegment[]
  uploadedMediaAssets                 MediaAsset[]                @relation("MediaAssetUploadedBy")
  accounts                            Account[]
  sessions                            Session[]
  passwordResetTokens                 PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive, isInactive])
  @@index([activationStatus])
  @@index([createdVia, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([pendingEmail, pendingEmailTokenExpiresAt])
  @@index([lastLoginAt])
}

model MediaAsset {
  id               String    @id @default(cuid())
  path             String    @unique
  mimeType         String
  sizeBytes        Int
  originalFilename String
  storageFilename  String    @unique
  uploadedById     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  uploadedBy User      @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  products   Product[]

  @@index([uploadedById, createdAt])
  @@index([mimeType])
}

model PendingUserRegistration {
  id             String         @id @default(cuid())
  email          String         @unique
  firstName      String
  lastName       String
  passwordHash   String
  role           Role           @default(CLIENT)
  createdVia     UserCreatedVia @default(PUBLIC_SIGNUP)
  createdIp      String?
  tokenHash      String         @unique
  tokenExpiresAt DateTime
  consumedAt     DateTime?
  userId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, tokenExpiresAt])
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([phone])
}

model TeacherProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  phone          String?
  bio            String?
  specialties    String[]
  certifications String[]
  hireDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([phone])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  description           String?
  productType           ProductType
  isActive              Boolean                @default(true)
  isArchived            Boolean                @default(false)
  sortOrder             Int                    @default(0)
  imageAssetId          String?
  prices                Price[]
  entitlementRules      EntitlementRule[]
  clientEntitlements    ClientEntitlement[]
  orderItems            OrderItem[]
  subscriptionContracts SubscriptionContract[]
  imageAsset            MediaAsset?            @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([productType, isActive])
  @@index([imageAssetId])
  @@index([sortOrder])
}

model Price {
  id                    String                 @id @default(cuid())
  productId             String
  lookupKey             String                 @unique
  stripePriceId         String?                @unique
  stripeSyncStatus      StripeSyncStatus       @default(PENDING)
  stripeSyncLastAttempt DateTime?
  stripeSyncLastSuccess DateTime?
  stripeSyncErrorCode   String?
  stripeSyncError       String?
  stripeSyncCorrelation String?
  name                  String
  priceType             PriceType
  currencyCode          String
  unitAmountMinor       Int
  billingInterval       BillingInterval?
  billingIntervalCount  Int?
  isActive              Boolean                @default(true)
  isArchived            Boolean                @default(false)
  startsAt              DateTime?
  endsAt                DateTime?
  orderItems            OrderItem[]
  selectedByBookings    Booking[]              @relation("BookingSelectedPrice")
  subscriptionContracts SubscriptionContract[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, isActive])
  @@index([priceType, billingInterval])
  @@index([startsAt, endsAt])
  @@index([stripeSyncStatus])
}

model EntitlementRule {
  id               String           @id @default(cuid())
  productId        String
  entitlementType  EntitlementType
  entitlementScope EntitlementScope
  quantity         Int?
  validForDays     Int?
  giftValueMinor   Int?
  notes            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, entitlementType, entitlementScope])
  @@index([entitlementType, entitlementScope])
  @@index([isActive])
}

model ClassCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  classTypes  ClassType[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

model ClassType {
  id                     String             @id @default(cuid())
  categoryId             String
  name                   String
  slug                   String             @unique
  description            String?
  imageUrl               String?
  defaultDurationMinutes Int
  defaultCapacity        Int
  isActive               Boolean            @default(true)
  isVisible              Boolean            @default(true)
  pricingMode            ServicePricingMode @default(SINGLE_OR_PLAN)
  sortOrder              Int                @default(0)
  serviceScope           EntitlementScope?
  category               ClassCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  templates              ClassTemplate[]
  studioSessions         StudioSession[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([categoryId, isActive, isVisible, sortOrder])
}

model LearningProgram {
  id              String   @id @default(cuid())
  legacyId        String   @unique
  mainTitle       String
  mainDescription String?
  courseType      String   @unique
  title           String
  description1    String?
  description2    String?
  description3    String?
  videoPromo      String?
  picture1        String?
  picture2        String?
  picture3        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningCourse {
  id               String   @id @default(cuid())
  legacyId         String   @unique
  title            String
  description      String?
  shortDescription String?
  category         String
  categoryType     String?
  categoryLevel    String?
  thumbnail        String?
  videoUrl         String?
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([priority])
}

model ClassTemplate {
  id                     String          @id @default(cuid())
  classTypeId            String
  defaultTeacherId       String
  title                  String
  slug                   String          @unique
  description            String?
  location               String?
  defaultCapacity        Int
  defaultDurationMinutes Int
  isActive               Boolean         @default(true)
  isPublished            Boolean         @default(true)
  classType              ClassType       @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  defaultTeacher         User            @relation("TemplateDefaultTeacher", fields: [defaultTeacherId], references: [id], onDelete: Restrict)
  recurringRules         RecurringRule[]
  studioSessions         StudioSession[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([classTypeId, isActive, isPublished])
  @@index([defaultTeacherId])
}

model RecurringRule {
  id              String          @id @default(cuid())
  classTemplateId String
  weekday         Weekday
  startTime       String
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean         @default(true)
  classTemplate   ClassTemplate   @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)
  studioSessions  StudioSession[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([classTemplateId, weekday, startTime, startDate])
  @@index([classTemplateId, isActive])
  @@index([weekday, startDate, endDate])
}

model StudioSession {
  id              String              @id @default(cuid())
  classTemplateId String
  recurringRuleId String?
  classTypeId     String
  teacherId       String
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  capacity        Int
  status          StudioSessionStatus @default(SCHEDULED)
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledById   String?
  isPublished     Boolean             @default(true)
  classTemplate   ClassTemplate       @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  recurringRule   RecurringRule?      @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  classType       ClassType           @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  teacher         User                @relation("StudioSessionTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  cancelledBy     User?               @relation("StudioSessionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([classTemplateId, startsAt])
  @@index([startsAt, status, isPublished])
  @@index([teacherId, startsAt])
  @@index([classTypeId, startsAt])
  @@index([classTemplateId, startsAt])
  @@index([recurringRuleId, startsAt])
}

model Booking {
  id                          String                   @id @default(cuid())
  clientId                    String?
  studioSessionId             String
  orderId                     String?
  status                      BookingStatus            @default(CONFIRMED)
  bookingIntent               BookingIntent            @default(SINGLE_BOOKING)
  paymentSelection            BookingPaymentSelection?
  selectedEntitlementId       String?
  selectedPriceId             String?
  draftAmountMinor            Int?
  draftCurrencyCode           String?
  bookedAt                    DateTime                 @default(now())
  customerName                String?
  customerEmail               String?
  customerPhone               String?
  customerMessage             String?
  consentTermsAccepted        Boolean                  @default(false)
  consentPrivacyAccepted      Boolean                  @default(false)
  consentAcceptedAt           DateTime?
  cancellationEligibleUntilAt DateTime?
  creditRefundedAt            DateTime?
  cancelledAt                 DateTime?
  cancellationReason          String?
  cancelledById               String?
  client                      User?                    @relation("BookingClient", fields: [clientId], references: [id], onDelete: SetNull)
  studioSession               StudioSession            @relation(fields: [studioSessionId], references: [id], onDelete: Restrict)
  order                       Order?                   @relation("BookingOrder", fields: [orderId], references: [id], onDelete: SetNull)
  selectedEntitlement         ClientEntitlement?       @relation("BookingSelectedEntitlement", fields: [selectedEntitlementId], references: [id], onDelete: SetNull)
  selectedPrice               Price?                   @relation("BookingSelectedPrice", fields: [selectedPriceId], references: [id], onDelete: SetNull)
  payments                    Payment[]                @relation("BookingPayment")
  cancelledBy                 User?                    @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  attendanceRecord            AttendanceRecord?
  creditLedgerEntries         CreditLedgerEntry[]
  clientMessages              ClientMessage[]          @relation("ClientMessageBooking")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@index([clientId, status, bookedAt])
  @@index([studioSessionId, status])
  @@index([orderId])
  @@index([selectedEntitlementId])
  @@index([selectedPriceId])
  @@index([customerEmail, bookedAt])
  @@index([studioSessionId, customerEmail])
  @@index([cancelledById])
  @@index([cancellationEligibleUntilAt])
}

model BookingPolicy {
  id                        String   @id @default(cuid())
  scope                     String   @unique @default("GLOBAL")
  cancellationCutoffHours   Int      @default(24)
  checkInOpensMinutesBefore Int      @default(15)
  checkInClosesMinutesAfter Int      @default(10)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  scope     String   @unique @default("GLOBAL")
  timeZone  String   @default("Europe/Brussels")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteWeeklyScheduleEntry {
  id           String   @id @default(cuid())
  dayOfWeek    Weekday
  startTime    String
  endTime      String
  serviceId    String?
  label        String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dayOfWeek, displayOrder, startTime])
  @@index([isActive, dayOfWeek])
  @@index([serviceId])
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  clientId        String
  studioSessionId String
  status          WaitlistStatus @default(ACTIVE)
  position        Int
  joinedAt        DateTime       @default(now())
  promotedAt      DateTime?
  client          User           @relation("WaitlistClient", fields: [clientId], references: [id], onDelete: Restrict)
  studioSession   StudioSession  @relation(fields: [studioSessionId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([clientId, studioSessionId])
  @@index([studioSessionId, status, position])
  @@index([clientId, status])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  bookingId  String           @unique
  status     AttendanceStatus
  source     AttendanceSource @default(DASHBOARD)
  markedAt   DateTime         @default(now())
  markedById String
  notes      String?
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([markedById, markedAt])
  @@index([status, markedAt])
}

model Order {
  id                          String                       @id @default(cuid())
  clientId                    String
  subtotalAmountMinor         Int
  discountAmountMinor         Int                          @default(0)
  totalAmountMinor            Int
  currencyCode                String
  status                      OrderStatus                  @default(PLACED)
  placedAt                    DateTime                     @default(now())
  notes                       String?
  client                      User                         @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  items                       OrderItem[]
  payments                    Payment[]
  bookings                    Booking[]                    @relation("BookingOrder")
  clientEntitlements          ClientEntitlement[]
  creditLedgerEntries         CreditLedgerEntry[]
  loyaltyLedgerEntries        LoyaltyLedgerEntry[]
  giftCardLedgerEntries       GiftCardLedgerEntry[]
  giftCardRedemptions         GiftCardRedemption[]
  giftCardReconciliationCases GiftCardReconciliationCase[]
  giftCardCodes               GiftCardCode[]
  adminNotes                  AdminNote[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@index([clientId, status, placedAt])
  @@index([placedAt])
}

model OrderItem {
  id                      String                @id @default(cuid())
  orderId                 String
  productId               String
  priceId                 String
  quantity                Int                   @default(1)
  productNameSnapshot     String
  priceNameSnapshot       String
  unitAmountMinor         Int
  lineSubtotalAmountMinor Int
  lineDiscountAmountMinor Int                   @default(0)
  lineTotalAmountMinor    Int
  currencyCode            String
  order                   Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                 Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  price                   Price                 @relation(fields: [priceId], references: [id], onDelete: Restrict)
  giftCardLedgerEntries   GiftCardLedgerEntry[]
  giftCardCode            GiftCardCode?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([priceId])
}

model Payment {
  id                          String                       @id @default(cuid())
  orderId                     String?
  bookingId                   String?
  status                      PaymentStatus
  method                      PaymentMethod
  provider                    PaymentProvider
  providerReference           String?
  stripeCheckoutSessionId     String?                      @unique
  stripeCustomerId            String?
  stripeCheckoutMode          StripeCheckoutMode?
