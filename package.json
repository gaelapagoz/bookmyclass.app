{
    "name":  "studio.saas.platform",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "build:e2e":  "npm run build",
                    "start":  "next start",
                    "start:e2e":  "node scripts/e2e-local-start-server.mjs",
                    "lint":  "eslint",
                    "test":  "tsx scripts/test-entry.ts",
                    "test:vitest":  "vitest",
                    "test:unit": "npx vitest --config vitest.unit.config.ts --run",
                    "test:integration": "tsx scripts/test-vitest-run-files.ts --config vitest.integration.config.ts --run test/integration",
                    "prisma:generate":  "prisma generate",
                    "prisma:seed":  "prisma db seed",
                    "db:reset":  "prisma migrate reset --force \u0026\u0026 prisma db seed",
                    "learning:import":  "tsx scripts/learning-server-import-platform.ts",
                    "db:seed":  "npm run prisma:seed",
                    "db:test:setup":  "npx dotenv -e .env.test -- prisma migrate deploy",
                    "db:test:reset":  "npx dotenv -e .env.test -- prisma migrate reset --force",
                    "db:e2e:migrate":  "npx dotenv -o -e .env.e2e -- prisma migrate deploy",
                    "db:e2e:seed":  "npx dotenv -o -e .env.e2e -- cross-env BOOKMYCLASS_SEED_MODE=development tsx scripts/e2e-server-seed.ts",
                    "db:e2e:reset":  "npm run db:e2e:migrate \u0026\u0026 npm run db:e2e:seed",
                    "db:e2e:setup":  "npm run db:e2e:migrate \u0026\u0026 npm run db:e2e:seed",
                    "e2e:clean-uploads":  "tsx scripts/e2e-clean-uploads.ts",
                    "verify:e2e-config":  "npx dotenv -o -e .env.e2e -- tsx scripts/e2e-verify-config.ts",
                    "verify:e2e-artifacts":  "tsx scripts/verify-e2e-artifacts.ts",
                    "verify:no-legacy-contract":  "tsx scripts/verify-no-legacy-contract.ts",
                    "verify:no-legacy-docs":  "tsx scripts/verify-no-legacy-docs.ts",
                    "test:e2e":  "npm run e2e:clean-uploads \u0026\u0026 npm run verify:e2e-config \u0026\u0026 npm run db:e2e:reset \u0026\u0026 npm run build:e2e \u0026\u0026 playwright test \u0026\u0026 npm run verify:e2e-artifacts",
                    "test:e2e:ci":  "npm run e2e:clean-uploads \u0026\u0026 npm run verify:e2e-config \u0026\u0026 npm run db:e2e:reset \u0026\u0026 npm run build:e2e \u0026\u0026 playwright test --reporter=line \u0026\u0026 npm run verify:e2e-artifacts",
                    "test:e2e:store":  "playwright test --grep @store",
                    "test:e2e:booking":  "playwright test --grep @booking",
                    "test:e2e:install":  "playwright install chromium",
                    "test:e2e:install:deps":  "playwright install --with-deps chromium",
                    "test:e2e:uat":  "playwright test -c playwright.uat.config.ts --reporter=line",
                    "db:verify:dashboard-seed":  "tsx scripts/dashboard-server-verify-seed-db.ts",
                    "db:verify:dashboard-trend-seed":  "tsx scripts/dashboard-server-verify-trend-seed-db.ts",
                    "verify:db:schema":  "tsx scripts/db-server-verify-schema.ts",
                    "verify:catalog:production":  "tsx scripts/catalog-server-verify-readiness.ts",
                    "verify:gift-card-maintenance":  "tsx scripts/giftcard-server-verify-maintenance.ts",
                    "verify:media-runtime":  "tsx scripts/media-server-verify-runtime.ts",
                    "media:verify":  "tsx scripts/verify-media-platform-readiness.ts",
                    "email:verify":  "dotenv -e .env.local -- tsx scripts/verify-email-platform-readiness.ts",
                    "email:provision-templates":  "dotenv -e .env -- tsx scripts/provision-email-templates.ts",
                    "media:backfill":  "tsx scripts/backfill-uploaded-media.ts",
                    "ops:verify-readiness":  "bash scripts/ops-server-verify-readiness.sh",
                    "db:seed:server:k6":  "cross-env UAT_K6_SEED=1 tsx scripts/performance-server-seed-fixtures.ts",
                    "db:seed:uat:k6":  "npm run db:seed:server:k6 && npm run db:verify:uat:k6",
                    "db:verify:uat:k6":  "tsx scripts/db-server-verify-uat-k6-seed.ts",
                    "db:seed:dev":  "dotenv -e .env -- cross-env BOOKMYCLASS_SEED_MODE=development prisma db seed",
                    "db:seed:staging":  "dotenv -e .env -- cross-env BOOKMYCLASS_SEED_MODE=staging prisma db seed",
                    "db:seed:demo":  "dotenv -e .env -- cross-env BOOKMYCLASS_SEED_MODE=demo prisma db seed",
                    "db:seed:staging:e2e":  "tsx scripts/seed-staging-e2e.ts",
                    "db:seed:uat:e2e":  "npm run db:seed:staging:e2e",
                    "db:verify:staging:e2e":  "tsx scripts/verify-staging-e2e-seed.ts",
                    "verify:seed:credential-policy": "tsx scripts/verify-seed-credential-policy.ts",
                    "db:seed:prod":  "dotenv -e .env -- cross-env BOOKMYCLASS_SEED_MODE=production prisma db seed",
                    "db:unlock:admin-abuse":  "dotenv -e .env -- tsx scripts/auth-server-unlock-admin-login-abuse.ts",
                    "db:ensure:dev-admin":  "dotenv -e .env -- tsx scripts/auth-local-ensure-dev-admin.ts",
                    "k6:discover:server":  "tsx scripts/performance-server-discover-fixtures.ts",
                    "qa:e2e:coverage":  "tsx scripts/e2e-report-coverage.ts",
                    "test:uat:smoke":  "tsx scripts/deploy-server-smoke-check.ts",
                    "demo:screenshots":  "playwright test -c playwright.demo.config.ts",
                    "stripe:catalog:sync":  "tsx scripts/catalog-server-sync-stripe.ts",
                    "test:staging:smoke":  "npm run test:uat:smoke",
                    "test:e2e:staging":  "npm run test:e2e:uat"
                },
    "dependencies":  {
                         "@auth/prisma-adapter":  "^2.11.1",
                         "@prisma/adapter-pg":  "^7.5.0",
                         "@prisma/client":  "^7.5.0",
                         "@sentry/nextjs":  "^10.47.0",
                         "@tailwindcss/postcss":  "^4.2.2",
                         "@tiptap/extension-link":  "^3.22.0",
                         "@tiptap/extension-text-align":  "^3.22.0",
                         "@tiptap/extension-text-style":  "^3.22.0",
                         "@tiptap/extension-underline":  "^3.22.0",
                         "@tiptap/react":  "^3.22.0",
                         "@tiptap/starter-kit":  "^3.22.0",
                         "bcryptjs":  "^3.0.3",
                         "dotenv":  "17.3.1",
                         "next":  "16.2.0",
                         "next-auth":  "^5.0.0-beta.30",
                         "pg":  "^8.20.0",
                         "react":  "19.2.4",
                         "react-dom":  "19.2.4",
                         "stripe":  "^18.4.0",
                         "tsx":  "4.21.0",
                         "zod":  "^4.3.6"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.58.2",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.2",
                            "@testing-library/user-event":  "^14.6.1",
                            "@types/node":  "^20.19.37",
                            "@types/pg":  "^8.18.0",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@vitest/coverage-v8":  "^4.1.0",
                            "babel-plugin-react-compiler":  "^1.0.0",
                            "cross-env":  "^10.1.0",
                            "dotenv-cli":  "^11.0.0",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.2.0",
                            "jsdom":  "^29.0.1",
                            "prisma":  "^7.5.0",
                            "sharp":  "^0.34.5",
                            "tailwindcss":  "^4",
                            "typescript":  "^5",
                            "vitest":  "^4.1.0"
                        },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               }
}


