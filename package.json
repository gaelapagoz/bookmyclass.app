{
  "name": "studio.saas.platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "npm run build",
    "start": "next start",
    "start:e2e": "node scripts/start-e2e-server.mjs",
    "lint": "eslint",
    "test": "node scripts/run-vitest-files.mjs",
    "test:vitest": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "learning:import": "tsx scripts/import-learning-platform.ts",
    "db:seed": "npm run prisma:seed",
    "db:test:setup": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:e2e:migrate": "dotenv -e .env.e2e -- prisma migrate deploy",
    "db:e2e:seed": "dotenv -e .env.e2e -- tsx scripts/e2e-seed.ts",
    "db:e2e:reset": "npm run db:e2e:migrate && npm run db:e2e:seed",
    "db:e2e:setup": "npm run db:e2e:migrate && npm run db:e2e:seed",
    "verify:e2e-config": "dotenv -e .env.e2e -- tsx scripts/verify-e2e-config.ts",
    "test:e2e": "npm run verify:e2e-config && npm run db:e2e:reset && npm run build:e2e && playwright test",
    "test:e2e:ci": "npm run verify:e2e-config && npm run db:e2e:reset && npm run build:e2e && playwright test --reporter=line",
    "test:e2e:store": "playwright test --grep @store",
    "test:e2e:booking": "playwright test --grep @booking",
    "test:e2e:uat": "playwright test -c playwright.uat.config.ts --reporter=line",
    "db:verify:dashboard-seed": "tsx scripts/verify-dashboard-seed-db.ts",
    "db:verify:dashboard-trend-seed": "tsx scripts/verify-dashboard-trend-seed-db.ts",
    "verify:db:schema": "tsx scripts/verify-db-schema.ts",
    "verify:catalog:production": "tsx scripts/verify-production-catalog-readiness.ts",
    "verify:gift-card-maintenance": "tsx scripts/verify-gift-card-maintenance.ts",
    "verify:media-runtime": "tsx scripts/verify-media-runtime.ts",
    "ops:verify-production-readiness": "bash scripts/verify-production-readiness.sh",
    "db:seed:uat:k6": "UAT_K6_SEED=1 tsx scripts/seed-uat-k6.ts",
    "db:seed:dev": "dotenv -e .env.local -- cross-env BOOKMYCLASS_SEED_MODE=development prisma db seed",
    "db:seed:uat-performance": "dotenv -e .env.local -- cross-env BOOKMYCLASS_SEED_MODE=uat-performance prisma db seed",
    "db:seed:prod": "dotenv -e .env.production -- cross-env BOOKMYCLASS_SEED_MODE=production prisma db seed",
    "k6:discover:uat": "tsx scripts/k6-discover-uat.ts",
    "qa:e2e:coverage": "tsx scripts/e2e-coverage-report.ts",
    "test:uat:smoke": "tsx scripts/uat-smoke-check.ts",
    "demo:screenshots": "playwright test -c playwright.demo.config.ts",
    "stripe:catalog:sync": "tsx scripts/sync-stripe-catalog.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@sentry/nextjs": "^10.47.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tiptap/extension-link": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/extension-text-style": "^3.22.0",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "next": "16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^18.4.0",
    "tsx": "4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^29.0.1",
    "prisma": "^7.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
